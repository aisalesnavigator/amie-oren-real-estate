# Canonical site URL (no trailing slash). Leave empty to use the default in src/config/siteUrl.ts.
PUBLIC_SITE_URL=
# Contact + Referral form endpoint (Formspree). A form endpoint is public by design - not a secret.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mnpnylyj
