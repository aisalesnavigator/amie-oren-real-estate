---
import BaseLayout from '../layouts/BaseLayout.astro';
import { primaryNav } from '../config/nav';
---

<BaseLayout title="Page not found" description="The page you’re looking for could not be found." path="/404/" noindex>
  <section class="section">
    <div class="container container--narrow stack">
      <span class="eyebrow">404</span>
      <h1>We couldn’t find that page.</h1>
      <p class="lede">It may have moved, or the address may have been mistyped. These may help:</p>
      <ul class="links">
        {primaryNav.map((i) => <li><a class="text-link" href={i.href}>{i.label}</a></li>)}
      </ul>
      <a class="btn btn--primary" href="/contact/">Start a Conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .links {
    list-style: none;
    padding: 0;
    columns: 2;
  }
</style>
