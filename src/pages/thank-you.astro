---
import BaseLayout from '../layouts/BaseLayout.astro';

const variants = {
  contact: {
    title: 'Thank you. Your message is on its way to me.',
    text: 'I’ll reply personally, usually as soon as I can. If your question is time-sensitive, you’re also welcome to email me directly.',
  },
  review: {
    title: 'Thank you for sharing your experience.',
    text: 'Your review has been received. I’ll read and verify it before anything is published, and I may reach out if I have a question.',
  },
  referral: {
    title: 'Thank you for the introduction.',
    text: 'I have your referral and will reach out thoughtfully. I’m grateful for your trust.',
  },
  search: {
    title: 'Thank you. I’ll set up your search.',
    text: 'I’ll review what you’re looking for and create a saved search so I can send you matching homes as they become available. I set these up by hand, so you’ll hear from me personally.',
  },
} as const;
const generic = {
  title: 'Thank you. Your message has been received.',
  text: 'I’ll be in touch personally. If your question is time-sensitive, you’re also welcome to email me directly.',
};
---

<BaseLayout title="Thank You" description="Thank you for getting in touch with Amie Oren." path="/thank-you/" noindex>
  <section class="section">
    <div class="container container--narrow center stack thanks">
      <span class="eyebrow">Received</span>
      <h1 data-thanks-title>{generic.title}</h1>
      <p class="lede center" data-thanks-text>{generic.text}</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Return Home</a>
        <a class="btn btn--secondary" href="/communities/">Explore West Michigan</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ variants }}>
  const form = new URLSearchParams(window.location.search).get('form');
  const v = form && Object.hasOwn(variants, form) ? variants[form] : null;
  if (v) {
    document.querySelector('[data-thanks-title]').textContent = v.title;
    document.querySelector('[data-thanks-text]').textContent = v.text;
  }
</script>

<style>
  h1 {
    font-size: var(--step-4);
  }
  .thanks {
    padding-block: var(--space-xl);
  }
</style>
