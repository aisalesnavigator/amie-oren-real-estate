---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicePathCard from '../components/ServicePathCard.astro';
import CommunityGrid from '../components/CommunityGrid.astro';
import AmieProfile from '../components/AmieProfile.astro';
import ImageSlot from '../components/ImageSlot.astro';
import InsightCard from '../components/InsightCard.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ReferralCTA from '../components/ReferralCTA.astro';
import ConversationCTA from '../components/ConversationCTA.astro';
import { site } from '../config/site';
import { getInsights } from '../utils/insights';
import { agentSchema, personSchema } from '../utils/schema';
import { absoluteUrl } from '../utils/url';
import headshot from '../assets/amie/amie-headshot.png';

const insights = (await getInsights()).slice(0, 3);
const portraitUrl = absoluteUrl((await getImage({ src: headshot, width: 800, format: 'jpg' })).src);
const tones = ['sand', 'lake', 'moss'] as const;

const lifeMoments = [
  'Moving up as a household grows',
  'Downsizing and simplifying',
  'Relocating to or within West Michigan',
  'Selling a longtime family home',
  'Buying or selling on the water',
  'Making a significant financial decision',
];
---

<BaseLayout
  title="Real estate guidance for the moments that matter"
  description="Amie Oren brings experience, local knowledge, attention to detail, and highly personal service to buyers and sellers navigating important moves throughout West Michigan."
  path="/"
  jsonLd={[agentSchema(portraitUrl), personSchema(portraitUrl)]}
>
  <Hero />

  <section class="area-strip" aria-label="Areas served">
    <div class="container area-strip__inner">
      <span class="eyebrow">Serving</span>
      <ul>
        {site.serviceAreas.map((a) => <li><a href={a.href}>{a.name}</a></li>)}
        <li><a href="/communities/">Greater Grand Rapids &amp; West Michigan</a></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="positioning-heading">
    <div class="container split split--wide-right">
      <div>
        <span class="eyebrow">A more attentive way to move</span>
        <h2 id="positioning-heading">A move is rarely only about the house.</h2>
      </div>
      <div class="stack">
        <p class="lede">
          Behind most transactions is a larger moment: a growing family, a changing pace, a home that holds
          decades of memories, a decision that deserves to be made carefully.
        </p>
        <p>
          Amie helps clients navigate the whole move, not just the transaction. That means listening first,
          preparing thoughtfully, bringing local knowledge and judgment to each decision, and carrying the
          details through so clients are never left chasing for answers.
        </p>
        <ul class="attributes">
          <li>Preparation</li>
          <li>Local knowledge</li>
          <li>Clear communication</li>
          <li>Attention to detail</li>
          <li>Careful negotiation</li>
          <li>Personal service</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--limestone" aria-labelledby="paths-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Where to begin</span>
        <h2 id="paths-heading">Three ways into the conversation.</h2>
      </div>
      <div class="grid grid--3">
        <ServicePathCard
          number="i."
          title="Selling"
          text="Selling a home deserves more than putting it on the market. See how preparation, positioning, and steady communication shape a sale."
          href="/selling/"
          linkLabel="Selling with Amie"
        />
        <ServicePathCard
          number="ii."
          title="Buying"
          text="Find the right home and understand what you’re choosing: the setting, the condition, the tradeoffs, and the offer."
          href="/buying/"
          linkLabel="Buying with Amie"
        />
        <ServicePathCard
          number="iii."
          title="Communities"
          text="Rockford, Ada, East Grand Rapids, Cascade, and Forest Hills, each with its own character and its own questions worth asking."
          href="/communities/"
          linkLabel="Explore communities"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="communities-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Community discovery</span>
        <h2 id="communities-heading">Know the place before you choose the house.</h2>
        <p class="lede">
          Each community page is a practical guide to the questions buyers and sellers should consider, written
          to help you decide, not to sell you on a zip code.
        </p>
      </div>
      <CommunityGrid />
    </div>
  </section>

  <section class="section section--limestone" aria-labelledby="amie-heading">
    <div class="container split split--wide-right">
      <div class="amie-portrait">
        <AmieProfile variant="feature" />
      </div>
      <div class="stack">
        <span class="eyebrow">Meet Amie</span>
        <h2 id="amie-heading">Calm, prepared, and personally involved.</h2>
        <p class="lede">
          Clients should feel that someone is paying close attention, because someone is.
        </p>
        <p>
          Amie Oren is a {site.professionalTitle.toLowerCase()} with {site.brokerage}, serving buyers and sellers across West
          Michigan. Her approach is built on listening carefully, anticipating what comes next, and staying
          close to the details that make a move go smoothly.
        </p>
        <a class="text-link" href="/about/">Read Amie’s story</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="moments-heading">
    <div class="container split">
      <div>
        <span class="eyebrow">Life moments</span>
        <h2 id="moments-heading">Every move has its own reason.</h2>
        <p class="lede">
          Whatever is behind yours, the work starts with understanding what the move needs to accomplish.
        </p>
        <a class="btn btn--secondary" href="/contact/">Tell Amie About Yours</a>
      </div>
      <ul class="moments">
        {lifeMoments.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--lake" aria-labelledby="waterfront-heading">
    <div class="container split split--wide-left">
      <div class="stack">
        <span class="eyebrow">Waterfront</span>
        <h2 id="waterfront-heading">Buy the water as carefully as you buy the home.</h2>
        <p class="lede" style="color:#e8eef0">
          Shoreline, access, orientation, and use all shape what a waterfront property is really like to own.
          Amie helps clients look beyond the view.
        </p>
        <a class="btn btn--light" href="/waterfront/">Explore Waterfront</a>
      </div>
      <ImageSlot ratio="5 / 4" tone="lake" caption="West Michigan shoreline" />
    </div>
  </section>

  {
    insights.length > 0 && (
      <section class="section" aria-labelledby="insights-heading">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Insights</span>
            <h2 id="insights-heading">Useful answers, plainly explained.</h2>
          </div>
          <div class="grid grid--3">
            {insights.map((entry, i) => <InsightCard entry={entry} tone={tones[i % tones.length]} />)}
          </div>
          <p class="more"><a class="text-link" href="/insights/">All insights</a></p>
        </div>
      </section>
    )
  }

  <ReviewsSection limit={3} intro="Real clients, in their own words." />
  <ReferralCTA />
  <ConversationCTA />
</BaseLayout>

<style>
  .area-strip {
    border-block: 1px solid var(--c-line);
    background: var(--c-paper);
  }
  .area-strip__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m);
  }
  .area-strip .eyebrow {
    margin: 0;
  }
  .area-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .area-strip li {
    margin: 0;
  }
  .area-strip a {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--c-charcoal);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .area-strip a:hover {
    border-color: var(--c-lake);
  }
  .attributes {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-xs) var(--space-l);
  }
  .attributes li {
    padding-top: var(--space-xs);
    border-top: 1px solid var(--c-sand-deep);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--c-charcoal);
    margin: 0;
  }
  .amie-portrait {
    max-width: 28rem;
  }
  .moments {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .moments li {
    margin: 0;
    padding-block: var(--space-s);
    border-top: 1px solid var(--c-sand-deep);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--c-charcoal);
  }
  .moments li:last-child {
    border-bottom: 1px solid var(--c-sand-deep);
  }
  .more {
    margin-top: var(--space-xl);
  }
</style>
