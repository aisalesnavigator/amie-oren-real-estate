---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ImageSlot from '../components/ImageSlot.astro';
import FAQ from '../components/FAQ.astro';
import ConversationCTA from '../components/ConversationCTA.astro';
import { getInsights, insightHref } from '../utils/insights';
import { breadcrumbSchema } from '../utils/schema';

const topics = [
  {
    title: 'Shoreline and water access',
    text: 'What does the frontage actually look like: sandy, rocky, steep, or soft? Is it shared or private? Rights of access and use vary widely and should be confirmed in writing, not assumed from a listing.',
  },
  {
    title: 'Orientation and view',
    text: 'Which way does the home face? Sun, wind, and sightlines shape how a property feels at different times of day and across the seasons. Visit more than once if you can.',
  },
  {
    title: 'Privacy and neighbors',
    text: 'Waterfront often means being more visible, from the water and from neighboring properties. Consider boat traffic, spacing, and screening.',
  },
  {
    title: 'Elevation and the walk to the water',
    text: 'The relationship between the house and the shore matters: how steep the grade is, how you move between them, and whether that works for everyone who will use the property.',
  },
  {
    title: 'Docks and water use',
    text: 'If a dock, lift, or boating is part of your plan, find out what is in place, what is permitted, and who maintains it. Confirm with the appropriate authorities rather than relying on assumptions.',
  },
  {
    title: 'Intended use',
    text: 'Seasonal retreat, year-round home, entertaining hub, or future rental? The right property depends heavily on how you intend to live there.',
  },
  {
    title: 'Maintenance and the elements',
    text: 'Water, ice, wind, and moisture are hard on properties. Seawalls, docks, decks, and drainage all deserve careful attention and a realistic view of upkeep.',
  },
  {
    title: 'Inspections and due diligence',
    text: 'Waterfront properties often need additional investigation beyond a standard home inspection. Amie helps you decide what to look into and which qualified professionals to involve.',
  },
  {
    title: 'Future resale',
    text: 'The qualities that make a property special to you may or may not be the ones future buyers prize. It helps to consider both while you’re choosing.',
  },
];

const faq = [
  {
    question: 'Can Amie advise on regulations, permits, or environmental questions?',
    answer:
      'Amie can help you identify what to ask and who to ask. Rules about shoreline, docks, wetlands, and water use can be specific and change over time, so those questions belong with the relevant governmental authority or a qualified professional such as an attorney, surveyor, or environmental specialist.',
  },
  {
    question: 'Is a standard home inspection enough for a waterfront property?',
    answer:
      'Often it is only the starting point. Seawalls, docks, shoreline conditions, and drainage may call for specialists. Amie can help you plan the right due diligence.',
  },
  {
    question: 'Should I visit in more than one season?',
    answer:
      'If it is possible, yes. A lake or river can look and feel very different in summer, fall, and winter, and so can access, noise, and maintenance needs.',
  },
];

const articles = (await getInsights()).filter((e) => e.data.intent === 'waterfront').slice(0, 1);
---

<BaseLayout
  title="Waterfront & Lake Property in West Michigan"
  description="Buy the water as carefully as you buy the home. A practical guide to shoreline, access, orientation, docks, maintenance, due diligence, and resale for waterfront buyers and sellers."
  path="/waterfront/"
  jsonLd={[breadcrumbSchema([{ name: 'Home', href: '/' }, { name: 'Waterfront' }])]}
>
  <PageHero
    eyebrow="Waterfront"
    title="Buy the water as carefully as you buy the home."
    lede="A waterfront property is a home and a relationship with a body of water. Understanding both is what makes the purchase, and later the sale, go well."
    breadcrumbs={[{ name: 'Waterfront' }]}
    tone="limestone"
  >
    <a class="btn btn--primary" href="/contact/?interest=waterfront">Talk with Amie About Waterfront</a>
  </PageHero>

  <section class="section" aria-labelledby="topics-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What to look at</span>
        <h2 id="topics-heading">The questions that shape a waterfront decision.</h2>
        <p class="lede">
          Many are not visible in photographs. These are the ones Amie encourages clients to consider early.
        </p>
      </div>
      <div class="topics">
        {
          topics.map((t) => (
            <div class="topic">
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--lake">
    <div class="container split split--wide-left">
      <div class="stack">
        <span class="eyebrow">For sellers</span>
        <h2>The water is part of the story you’re selling.</h2>
        <p style="color:#e8eef0">
          Buyers are drawn to the view, but they invest in the details: the shoreline, the access, the condition
          of docks and walls, and what ownership will really be like. Presenting those clearly, and being ready
          for the questions they raise, builds buyer confidence.
        </p>
        <p style="color:#e8eef0">
          Photography, timing, and preparation all take on added importance when the water is the centerpiece.
        </p>
      </div>
      <ImageSlot ratio="5 / 4" tone="lake" caption="Shoreline and outdoor living" />
    </div>
  </section>

  <section class="section" aria-label="Important notice">
    <div class="container container--narrow">
      <div class="notice">
        <h2>A note on regulations and professional advice</h2>
        <p>
          Amie is a real estate professional, not an attorney, surveyor, or environmental specialist. Laws and
          regulations affecting shorelines, docks, wetlands, floodplains, and water use can be specific to a
          property and change over time. This page offers general guidance only. For any such question, please
          consult the appropriate governmental authority or a qualified professional.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--limestone" aria-label="Waterfront questions">
    <div class="container">
      <FAQ items={faq} heading="Waterfront questions" schema={false} />
      {
        articles.length > 0 && (
          <p class="more">
            Related reading: <a class="text-link" href={insightHref(articles[0])}>{articles[0].data.title}</a>
          </p>
        )
      }
    </div>
  </section>

  <ConversationCTA
    title="Considering the water?"
    text="Whether you’re buying, selling, or still imagining, Amie is glad to talk through what matters most."
    label="Talk with Amie About Waterfront"
    href="/contact/?interest=waterfront"
  />
</BaseLayout>

<style>
  .topics {
    display: grid;
    gap: var(--space-xl) var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .topic {
    border-top: 1px solid var(--c-sand-deep);
    padding-top: var(--space-m);
  }
  .topic h3 {
    font-size: var(--step-2);
  }
  .topic p {
    margin: 0;
  }
  .notice {
    border: 1px solid var(--c-sand-deep);
    border-radius: var(--radius-m);
    padding: var(--space-l);
    background: var(--c-paper);
  }
  .notice h2 {
    font-size: var(--step-2);
  }
  .notice p {
    margin: 0;
  }
  .more {
    margin-top: var(--space-xl);
  }
</style>
