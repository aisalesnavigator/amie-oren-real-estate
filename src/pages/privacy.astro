---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';
import { breadcrumbSchema } from '../utils/schema';

const hasEndpoint = Boolean(site.forms.contact || site.forms.review);
---

<BaseLayout
  title="Privacy"
  description="How this website handles information you choose to send to Amie Oren, in plain language."
  path="/privacy/"
  jsonLd={[breadcrumbSchema([{ name: 'Home', href: '/' }, { name: 'Privacy' }])]}
>
  <PageHero eyebrow="Privacy" title="Your privacy, in plain language." breadcrumbs={[{ name: 'Privacy' }]} />

  <section class="section" style="padding-top:0">
    <div class="container container--narrow prose">
      <p class="muted small">Last updated: October 1, 2026</p>

      <h2>What this site collects</h2>
      <p>
        This website does not use analytics, advertising pixels, tracking scripts, or a customer-management
        system, and it does not set cookies for tracking. The fonts and images it uses are served from the site
        itself.
      </p>
      <p>
        The only information the site receives is what you choose to send through its forms (Contact, Leave a
        Review, and Refer Someone): the details you enter, such as your name, email address, phone number, and
        message.
      </p>

      <h2>How form submissions work</h2>
      {
        hasEndpoint ? (
          <p>
            Form submissions are sent to a third-party form service, currently Formspree, which delivers them to
            Amie by email. That service processes your submission on its servers; its own privacy policy
            describes how it handles data. Submissions are also received in Amie’s email inbox.
          </p>
        ) : (
          <p>
            Forms on this site prepare an email to Amie. Nothing is sent until you send the message from your
            own email application.
          </p>
        )
      }

      <h2>How Amie uses your information</h2>
      <ul>
        <li>To reply to your message or inquiry.</li>
        <li>
          For reviews: to verify that a review is genuine. Reviews are never published automatically. Amie
          confirms them and your permission first, and your email address is never published.
        </li>
        <li>
          For referrals: to reach out to the person you introduced, in the way you suggested. Please share
          someone’s details only if they’re comfortable with it.
        </li>
      </ul>
      <p>Amie does not sell your information.</p>

      <h2>Emailing Amie directly</h2>
      <p>
        If you email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>, your message is handled
        by your email provider and Amie’s, under their policies.
      </p>

      <h2>External links</h2>
      <p>
        This site may link to other websites. Their practices are their own, so please review their policies.
      </p>

      <h2>Questions or requests</h2>
      <p>
        To ask what information you have sent, or to ask for it to be deleted, email
        <a href={`mailto:${site.contactEmail}`}> {site.contactEmail}</a>.
      </p>

      <h2>Changes</h2>
      <p>
        If this site later adds anything that affects privacy, such as analytics, this page will be updated
        before it goes live.
      </p>
    </div>
  </section>
</BaseLayout>
