---
import { getImage } from 'astro:assets';
import lifestyle from '../assets/amie/amie-lifestyle-wide.png';
import { site } from '../config/site';
import { absoluteUrl } from '../utils/url';

interface Props {
  title: string;
  description: string;
  /** Path on the site, e.g. "/selling/". Defaults to the current URL path. */
  path?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Provide a complete <title> (skips the " | brand" suffix). */
  fullTitle?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  type = 'website',
  image,
  imageAlt = 'Amie Oren in a lakeside living room',
  publishedTime,
  modifiedTime,
  fullTitle = false,
} = Astro.props;

const fullTitleText = fullTitle ? title : `${title} | ${site.brand}`;
const canonical = absoluteUrl(path);
const og = image ? absoluteUrl(image) : absoluteUrl((await getImage({ src: lifestyle, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: 'right' })).src);
---

<title>{fullTitleText}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.brand} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitleText} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitleText} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={imageAlt} />
