---
import Testimonial from './Testimonial.astro';
import { getVisibleReviews } from '../utils/reviews';

interface Props {
  /** Maximum number of reviews to show. */
  limit?: number;
  heading?: string;
  eyebrow?: string;
  intro?: string;
  /** Show the review-invitation panel when there are no approved reviews (default true). */
  showEmpty?: boolean;
  /** Show only reviews marked `featured` (the homepage uses this to stay restrained). */
  featuredOnly?: boolean;
  /** Link through to the full Client Experiences page. */
  moreLink?: boolean;
}
const {
  limit = 3,
  heading = 'Client experiences',
  eyebrow = 'In their words',
  intro,
  showEmpty = true,
  featuredOnly = false,
  moreLink = false,
} = Astro.props;
const all = await getVisibleReviews();
const featured = all.filter((r) => r.data.featured);
// Featured first; fall back to any approved review if none is featured.
const reviews = (featuredOnly && featured.length > 0 ? featured : all).slice(0, limit);
---

<section class="section section--limestone" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="reviews-heading">{heading}</h2>
      {intro && <p class="lede">{intro}</p>}
    </div>

    {
      reviews.length > 0 ? (
        <div class={`grid ${reviews.length >= 3 ? 'grid--3' : 'grid--2'}`} data-reviews-list>
          {reviews.map((r) => <Testimonial review={r} />)}
        </div>
      ) : (
        showEmpty && (
          <div class="reviews-empty" data-reviews-empty>
            <p class="reviews-empty__text">
              Amie’s client experiences will be shared here, in clients’ own words, once they have been
              verified and approved for publication.
            </p>
            <p class="muted">Worked with Amie? You’re welcome to share your experience.</p>
            <a class="btn btn--secondary" href="/review/">Leave a Review</a>
          </div>
        )
      )
    }
    {
      moreLink && reviews.length > 0 && (
        <p class="reviews-more">
          <a class="text-link" href="/client-experiences/">Read more client experiences</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .reviews-more {
    margin-top: var(--space-xl);
  }
  .reviews-empty {
    max-width: 40rem;
    padding-top: var(--space-m);
    border-top: 1px solid var(--c-sand-deep);
  }
  .reviews-empty__text {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--c-charcoal);
  }
</style>
