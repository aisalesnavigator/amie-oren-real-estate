---
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="process">
  {
    steps.map((s, i) => (
      <li class="process__item">
        <span class="process__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }
  .process__item {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-top: 1px solid var(--c-sand-deep);
    margin: 0;
  }
  .process__item:last-child {
    border-bottom: 1px solid var(--c-sand-deep);
  }
  .process__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--c-lake);
  }
  h3 {
    font-size: var(--step-3);
    margin-bottom: var(--space-2xs);
  }
  p {
    margin: 0;
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.6;
  }
  @media (min-width: 48em) {
    .process__item {
      grid-template-columns: 5rem minmax(0, 0.9fr) minmax(0, 1.2fr);
      align-items: start;
      gap: var(--space-l);
    }
    .process__item > div {
      display: contents;
    }
    h3 {
      margin: 0;
    }
    p {
      font-size: var(--step-0);
    }
  }
</style>
